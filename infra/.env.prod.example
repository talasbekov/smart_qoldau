# Пример окружения контура пилота. Скопировать в infra/.env, заполнить
# СВОИМИ значениями и не коммитить.
#
# Имена и форматы сверены с backend/src/config/env.validation.ts: значения
# проверяются Joi при старте, и приложение падает сразу, а не «когда-нибудь
# на первом платеже». Правило простое: ни одно значение отсюда не должно
# совпасть с dev — секрет, переехавший со стенда, скомпрометирован.

# --- База и хранилище -------------------------------------------------
POSTGRES_USER=sq
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=smartqoldau

S3_ACCESS_KEY=              # он же MINIO_ROOT_USER
S3_SECRET_KEY=              # openssl rand -base64 32
S3_BUCKET_DOCUMENTS=expert-documents
S3_BUCKET_AVATARS=sq-avatars
S3_BUCKET_CONTENT=sq-content
# Адрес, по которому клиенты забирают публичные файлы (аватары):
S3_PUBLIC_BASE_URL=https://cdn.example.kz

# --- Криптография -----------------------------------------------------
JWT_SECRET=                 # минимум 32 символа: openssl rand -base64 48
# Шифрование содержимого чата (AES-256-GCM). Ровно 64 HEX-символа, не
# base64: openssl rand -hex 32
# Потеря ключа = потеря всей переписки, он ниоткуда не восстанавливается.
CHAT_ENCRYPTION_KEY=

# Подписи вебхуков эквайера и выплат, минимум 32 символа каждая:
PAYMENT_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=

# --- Внешние сервисы --------------------------------------------------
SMS_PROVIDER=mobizon        # dev | mobizon; для mobizon ключ обязателен
MOBIZON_API_KEY=

LIVEKIT_URL=wss://livekit.example.kz
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Пока подключён только мок эквайера и пушей — боевые адаптеры
# добавляются вместе с интеграцией (см. SQD-16).
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=mock

# --- Обязательные в бою ------------------------------------------------
# Заданы в docker-compose.prod.yml, здесь для памяти:
#   NODE_ENV=production, TOTP_REQUIRED=true, THROTTLE_ENABLED=true,
#   SWAGGER_ENABLED не задавать (в production /v1/docs закрыт).
# Origin'ы админки для CORS, через запятую:
ADMIN_ORIGINS=https://admin.example.kz

# --- Первый вход в админку -------------------------------------------
# Оба заданы и таблица сотрудников пуста -> заводится первый суперадмин.
# Пароль от 12 символов. После первого входа обе строки убрать.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Публичные адреса -------------------------------------------------
# Вшивается в бандл админки на этапе СБОРКИ образа, а не читается в
# рантайме: для другого контура нужен другой образ.
PUBLIC_API_BASE_URL=https://api.example.kz/v1

# --- Образы (если тянутся из реестра, а не собираются на месте) -------
# BACKEND_IMAGE=registry.example.kz/smartqoldau-backend:2026.08.26
# ADMIN_IMAGE=registry.example.kz/smartqoldau-admin:2026.08.26
# LANDING_IMAGE=registry.example.kz/smartqoldau-landing:2026.08.26
