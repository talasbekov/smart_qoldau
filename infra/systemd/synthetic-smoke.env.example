# Copy to /etc/smart-qoldau/synthetic-smoke.env and replace every placeholder.
# These values are not secrets. The runner rejects credentials embedded in URLs.
SMOKE_BASE_URL=https://CHANGE-ME.invalid
SMOKE_WEB_URL=https://CHANGE-ME.invalid/ru
SMOKE_WEB_MARKER=CHANGE_ME_STATIC_MARKER
# Each timeout must be greater than 0 and no more than 5 seconds.
SMOKE_CONNECT_TIMEOUT=2
SMOKE_TOTAL_TIMEOUT=5
