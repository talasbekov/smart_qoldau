[Unit]
Description=Smart Qoldau read-only synthetic availability smoke
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=smart-qoldau-smoke
Group=smart-qoldau-smoke
EnvironmentFile=/etc/smart-qoldau/synthetic-smoke.env
ExecStart=/usr/bin/python3 /opt/CHANGE_ME/smart_qoldau/infra/scripts/synthetic-smoke.py
TimeoutStartSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
