# Public DNS names for the opt-in TLS overlay. Copy these keys into the same
# private infra/.env used by docker-compose.prod.yml. Values must be hostnames
# only: no scheme, port, path, quotes, wildcards, or credentials.
#
# Before starting the overlay, point all three DNS records at the host and
# allow inbound TCP 80/443 plus UDP 443. Caddy needs TCP 80/443 for public
# certificate issuance/renewal; UDP 443 enables HTTP/3.

WEB_HOSTNAME=
API_HOSTNAME=
ADMIN_HOSTNAME=

# Keep the related existing production values aligned with these names:
# - SITE_URL is the https:// URL for WEB_HOSTNAME (runtime web CSRF/origin gate).
# - PUBLIC_API_BASE_URL is the https:// URL for API_HOSTNAME plus /v1; it is
#   embedded while building both admin and web browser images, so rebuild both
#   images after an API hostname change.
# - ADMIN_ORIGINS must include the exact https:// URLs for both ADMIN_HOSTNAME
#   and WEB_HOSTNAME; never use a wildcard.
# - Guest support tickets go directly from the browser to PUBLIC_API_BASE_URL.
#   Existing authenticated BFF routes keep their cookie identity boundary.
# Export only these three hostname variables in the deployment shell, then run
# ./scripts/tls-proxy-preflight.sh before any public start. Do not source the
# private .env because it also contains credentials.

# Backend opt-in: leave empty until Caddy's exact peer IP is reserved and verified.
# Accepts comma-separated IPv4/IPv6 addresses only, never a Docker subnet/CIDR,
# service name, true, or a hop count. The overlay currently uses dynamic IPs.
# Existing authenticated BFF -> backend requests still identify the web peer,
# not the browser client. Guest tickets use the direct public API path above.
TRUSTED_PROXY_IPS=
