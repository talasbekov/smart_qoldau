{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "api:generate": "cd ../backend && npm run openapi:dump && cd ../web && npx --yes openapi-typescript@7.13.0 ../docs/openapi.json -o lib/api/generated.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "start:standalone": "mkdir -p public && cp -r public .next/standalone/ 2>/dev/null; cp -r .next/static .next/standalone/.next/ && node .next/standalone/server.js"
  },
  "dependencies": {
    "next": "^15.5.24",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
