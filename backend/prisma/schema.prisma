// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  phone         String?        @unique
  isGuest       Boolean        @default(false) @map("is_guest")
  // Частичный уникальный индекс users_device_id_guest_uq (raw SQL в миграции
  // 20260819122334_guest_device_id_partial_unique):
  //   UNIQUE(device_id) WHERE is_guest = true.
  // Prisma частичные индексы не выражает — не удалять при prisma migrate dev.
  deviceId      String?        @map("device_id")
  locale        String         @default("ru")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  expert        Expert?

  @@map("users")
}

model SmsCode {
  id         String   @id @default(uuid())
  phone      String   @unique
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")
  expiresAt  DateTime @map("expires_at")

  @@map("sms_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("refresh_tokens")
}

model Topic {
  id        String        @id @default(uuid())
  slug      String        @unique
  nameRu    String        @map("name_ru")
  nameKz    String        @map("name_kz")
  sortOrder Int           @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")
  experts   ExpertTopic[]

  @@map("topics")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   @map("actor_type") // 'user' | 'expert' | 'admin' | 'system'
  actorId    String?  @map("actor_id")
  entity     String
  entityId   String   @map("entity_id")
  transition String
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

enum ExperienceLevel {
  LESS_THAN_YEAR
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_TO_TEN
  MORE_THAN_TEN
}

enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
}

enum WorkStatus {
  ACCEPTING
  BUSY
  NOT_ACCEPTING
  UNAVAILABLE
}

enum DocumentType {
  IDENTITY
  DIPLOMA
  CERTIFICATES
  QUALIFICATION
}

enum DocumentStatus {
  UPLOADED
  APPROVED
  REUPLOAD_REQUIRED
}

model Expert {
  id                 String              @id @default(uuid())
  userId             String              @unique @map("user_id")
  user               User                @relation(fields: [userId], references: [id])
  displayName        String              @map("display_name")
  city               String
  experience         ExperienceLevel
  education          String
  priceTiyn          Int                 @map("price_tiyn")
  languages          String[]            // 'ru' | 'kz' | 'en'
  formats            String[]            // 'chat' | 'audio' | 'video'
  verificationStatus VerificationStatus  @default(DRAFT) @map("verification_status")
  workStatus         WorkStatus          @default(NOT_ACCEPTING) @map("work_status")
  isBlocked          Boolean             @default(false) @map("is_blocked")
  blockedReason      String?             @map("blocked_reason")
  acceptsUrgent      Boolean             @default(false) @map("accepts_urgent")
  createdAt          DateTime            @default(now()) @map("created_at")
  topics             ExpertTopic[]
  documents          ExpertDocument[]
  scheduleDays       ExpertScheduleDay[]
  @@map("experts")
}

model ExpertTopic {
  expertId String @map("expert_id")
  topicId  String @map("topic_id")
  expert   Expert @relation(fields: [expertId], references: [id])
  topic    Topic  @relation(fields: [topicId], references: [id])
  @@id([expertId, topicId])
  @@map("expert_topics")
}

model ExpertDocument {
  id        String         @id @default(uuid())
  expertId  String         @map("expert_id")
  expert    Expert         @relation(fields: [expertId], references: [id])
  type      DocumentType
  status    DocumentStatus @default(UPLOADED)
  fileKey   String         @map("file_key")
  comment   String?
  updatedAt DateTime       @updatedAt @map("updated_at")
  @@unique([expertId, type])
  @@map("expert_documents")
}

model ExpertScheduleDay {
  expertId   String  @map("expert_id")
  expert     Expert  @relation(fields: [expertId], references: [id])
  weekday    Int     // 0=Пн … 6=Вс
  enabled    Boolean @default(false)
  startMin   Int     @map("start_min")   // минуты от полуночи, 540 = 09:00
  endMin     Int     @map("end_min")
  breakStart Int?    @map("break_start")
  breakEnd   Int?    @map("break_end")
  @@id([expertId, weekday])
  @@map("expert_schedule_days")
}
