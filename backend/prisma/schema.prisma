// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  phone         String?        @unique
  isGuest       Boolean        @default(false) @map("is_guest")
  // Частичный уникальный индекс users_device_id_guest_uq (raw SQL в миграции
  // 20260819122334_guest_device_id_partial_unique):
  //   UNIQUE(device_id) WHERE is_guest = true.
  // Prisma частичные индексы не выражает — не удалять при prisma migrate dev.
  deviceId      String?        @map("device_id")
  locale        String         @default("ru")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model SmsCode {
  id         String   @id @default(uuid())
  phone      String   @unique
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")
  expiresAt  DateTime @map("expires_at")

  @@map("sms_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("refresh_tokens")
}

model Topic {
  id        String  @id @default(uuid())
  slug      String  @unique
  nameRu    String  @map("name_ru")
  nameKz    String  @map("name_kz")
  sortOrder Int     @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("topics")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   @map("actor_type") // 'user' | 'expert' | 'admin' | 'system'
  actorId    String?  @map("actor_id")
  entity     String
  entityId   String   @map("entity_id")
  transition String
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}
