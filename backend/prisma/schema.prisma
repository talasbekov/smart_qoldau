// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  phone         String?        @unique
  isGuest       Boolean        @default(false) @map("is_guest")
  // Частичный уникальный индекс users_device_id_guest_uq (raw SQL в миграции
  // 20260819122334_guest_device_id_partial_unique):
  //   UNIQUE(device_id) WHERE is_guest = true.
  // Prisma частичные индексы не выражает — не удалять при prisma migrate dev.
  deviceId      String?        @map("device_id")
  locale        String         @default("ru")
  // Аккаунт удалён по запросу пользователя (ТЗ §5.1, политика
  // конфиденциальности). Строка остаётся: на неё ссылаются консультации и
  // платежи — финансовый учёт терять нельзя, — но PII из неё вычищен, а
  // телефон освобождён, поэтому повторный вход по тому же номеру заводит
  // новый аккаунт, а не воскрешает этот.
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  expert        Expert?
  subscriptions Subscription[]

  @@map("users")
}

model SmsCode {
  id         String   @id @default(uuid())
  phone      String   @unique
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")
  expiresAt  DateTime @map("expires_at")

  @@map("sms_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("refresh_tokens")
}

model Topic {
  id            String         @id @default(uuid())
  slug          String         @unique
  nameRu        String         @map("name_ru")
  nameKz        String         @map("name_kz")
  sortOrder     Int            @map("sort_order")
  isActive      Boolean        @default(true) @map("is_active")
  experts       ExpertTopic[]
  requests      Request[]
  consultations Consultation[]

  @@map("topics")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   @map("actor_type") // 'user' | 'expert' | 'admin' | 'system'
  actorId    String?  @map("actor_id")
  entity     String
  entityId   String   @map("entity_id")
  transition String
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

enum ExperienceLevel {
  LESS_THAN_YEAR
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_TO_TEN
  MORE_THAN_TEN
}

enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
}

enum WorkStatus {
  ACCEPTING
  BUSY
  NOT_ACCEPTING
  UNAVAILABLE
}

enum DocumentType {
  IDENTITY
  DIPLOMA
  CERTIFICATES
  QUALIFICATION
}

enum DocumentStatus {
  UPLOADED
  APPROVED
  REUPLOAD_REQUIRED
}

// Состояние модерируемого поля публичного профиля (E2a).
enum ProfileFieldStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Expert {
  id                      String              @id @default(uuid())
  userId                  String              @unique @map("user_id")
  user                    User                @relation(fields: [userId], references: [id])
  displayName             String              @map("display_name")
  city                    String
  experience              ExperienceLevel
  education               String
  priceTiyn               Int                 @map("price_tiyn")
  languages               String[] // 'ru' | 'kz' | 'en'
  formats                 String[] // 'chat' | 'audio' | 'video'
  verificationStatus      VerificationStatus  @default(DRAFT) @map("verification_status")
  // Момент отправки анкеты на проверку. Нужен очереди верификации: ТЗ
  // §11.4 обещает решение за 24 часа, а без этой отметки оператор не
  // видит, какие заявки уже просрочены (createdAt эксперта — это дата
  // регистрации, не отправки, и после REUPLOAD_REQUIRED отсчёт
  // начинается заново).
  verificationSubmittedAt DateTime?           @map("verification_submitted_at")
  workStatus              WorkStatus          @default(NOT_ACCEPTING) @map("work_status")
  isBlocked               Boolean             @default(false) @map("is_blocked")
  blockedReason           String?             @map("blocked_reason")
  acceptsUrgent           Boolean             @default(false) @map("accepts_urgent")
  ratingAvg               Float               @default(0) @map("rating_avg")
  ratingCount             Int                 @default(0) @map("rating_count")
  // Публичный контент профиля (E2a). У фото и текста «о себе» два значения:
  // опубликованное и то, что на проверке. Пока новое проверяется, профиль
  // продолжает показывать старое (Р-18, перенесённый с документов на поля).
  photoKey                String?             @map("photo_key")
  photoPendingKey         String?             @map("photo_pending_key")
  photoStatus             ProfileFieldStatus  @default(NONE) @map("photo_status")
  about                   String?
  aboutPending            String?             @map("about_pending")
  aboutStatus             ProfileFieldStatus  @default(NONE) @map("about_status")
  moderationComment       String?             @map("moderation_comment") // причина последнего отказа
  createdAt               DateTime            @default(now()) @map("created_at")
  topics                  ExpertTopic[]
  documents               ExpertDocument[]
  scheduleDays            ExpertScheduleDay[]
  scheduleExceptions      ScheduleException[]

  // По статусам ходит очередь модерации — выбирает только PENDING.
  @@index([photoStatus])
  @@index([aboutStatus])
  @@map("experts")
}

model ExpertTopic {
  expertId String @map("expert_id")
  topicId  String @map("topic_id")
  expert   Expert @relation(fields: [expertId], references: [id])
  topic    Topic  @relation(fields: [topicId], references: [id])

  @@id([expertId, topicId])
  @@map("expert_topics")
}

// Исключение недельного расписания на конкретную дату (E6b): либо
// выходной целиком, либо иные часы.
model ScheduleException {
  id       String   @id @default(uuid())
  expertId String   @map("expert_id")
  expert   Expert   @relation(fields: [expertId], references: [id])
  date     DateTime @db.Date
  isDayOff Boolean  @default(true) @map("is_day_off")
  startMin Int?     @map("start_min")
  endMin   Int?     @map("end_min")

  @@unique([expertId, date])
  @@map("schedule_exceptions")
}

model ExpertDocument {
  id        String         @id @default(uuid())
  expertId  String         @map("expert_id")
  expert    Expert         @relation(fields: [expertId], references: [id])
  type      DocumentType
  status    DocumentStatus @default(UPLOADED)
  fileKey   String         @map("file_key")
  comment   String?
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([expertId, type])
  @@map("expert_documents")
}

model ExpertScheduleDay {
  expertId   String  @map("expert_id")
  expert     Expert  @relation(fields: [expertId], references: [id])
  weekday    Int // 0=Пн … 6=Вс
  enabled    Boolean @default(false)
  startMin   Int     @map("start_min") // минуты от полуночи, 540 = 09:00
  endMin     Int     @map("end_min")
  breakStart Int?    @map("break_start")
  breakEnd   Int?    @map("break_end")

  @@id([expertId, weekday])
  @@map("expert_schedule_days")
}

enum RequestStatus {
  SEARCHING
  MATCHED
  CANCELLED
  NO_EXPERTS
  CALLBACK_REQUESTED
}

enum CandidateResponse {
  PENDING
  ACCEPTED
  DECLINED
  TIMEOUT
  REVOKED
}

model Request {
  id               String             @id @default(uuid())
  clientUserId     String             @map("client_user_id")
  clientCode       Int                @map("client_code") // 1000–9999, показывается эксперту
  topicId          String             @map("topic_id")
  topic            Topic              @relation(fields: [topicId], references: [id])
  format           String // 'chat' | 'audio' | 'video'
  isEmergency      Boolean            @default(false) @map("is_emergency")
  directedExpertId String?            @map("directed_expert_id") // ручной выбор из каталога
  status           RequestStatus      @default(SEARCHING)
  matchedExpertId  String?            @map("matched_expert_id")
  broadcastAt      DateTime?          @map("broadcast_at") // момент эскалации 2 мин
  closedAt         DateTime?          @map("closed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  candidates       RequestCandidate[]

  @@index([clientUserId, status])
  @@map("requests")
}

// Частичный уникальный индекс request_candidates_pending_per_expert_uq (raw
// SQL в миграции 20260819160000_pending_offer_per_expert, заменившей более
// раннюю request_candidates_one_pending_uq):
//   UNIQUE(request_id, expert_id) WHERE response = 'PENDING'.
// Инвариант ослаблен с "один PENDING на заявку" до "один PENDING на пару
// (заявка, эксперт)" — иначе экстренный broadcast (Р-16, задача 6:
// EscalationService.broadcast()) не смог бы создать несколько одновременных
// PENDING-офферов одной заявки. Гейт "не более одного PENDING у ОБЫЧНОЙ
// (не broadcast) заявки" по-прежнему держится ЛОГИКОЙ offerToNext —
// перечитка статуса SEARCHING непосредственно перед create + исключение
// экспертов с уже существующим response этой заявки (см. комментарий у
// offerToNext() в requests.service.ts). Второй одновременный PENDING одной
// заявки возможен теперь только через EscalationService.broadcast(), которая
// создаёт офферы разным экспертам одним проходом. Prisma частичные индексы
// не выражает — не удалять при prisma migrate dev.
model RequestCandidate {
  id          String            @id @default(uuid())
  requestId   String            @map("request_id")
  request     Request           @relation(fields: [requestId], references: [id])
  expertId    String            @map("expert_id")
  offeredAt   DateTime          @map("offered_at")
  deadlineAt  DateTime          @map("deadline_at")
  respondedAt DateTime?         @map("responded_at")
  response    CandidateResponse @default(PENDING)

  @@index([requestId])
  @@index([expertId, response])
  @@map("request_candidates")
}

// Сознательно БЕЗ FK на users/experts (решение задачи 1): связка-строка,
// join выполняется вручную в FavoritesService. Скрытые/удалённые эксперты
// просто выпадают из выдачи, связка остаётся.
model Favorite {
  userId    String   @map("user_id")
  expertId  String   @map("expert_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, expertId])
  @@map("favorites")
}

enum ConsultationStatus {
  // Плановая запись на слот (E6b): согласие специалиста — его
  // опубликованное расписание, поэтому цепочки офферов здесь нет.
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING // создан, холд запрошен у провайдера
  HELD // холд подтверждён
  CAPTURED // списано (исход COMPLETED)
  VOIDED // холд отменён (возврат клиенту)
  FAILED // провайдер отклонил (банк отказал)
}

enum ConsultationPaymentStatus {
  UNPAID
  HELD
  CAPTURED
  VOIDED
  FAILED
}

enum PayoutStatus {
  PENDING_REVIEW // очередь финконтроля (>лимита автоодобрения)
  PROCESSING // одобрен (авто или вручную), отправлен провайдеру
  PAID // провайдер подтвердил зачисление
  REJECTED // отклонён финконтролем (с причиной)
}

enum ConsultationOutcome {
  COMPLETED
  CLIENT_NO_SHOW
  CLIENT_CANCELLED
  TECH_ISSUE
  // Отмена специалистом (E6b): клиенту полный возврат, специалисту 0 ₸.
  // TECH_ISSUE по смыслу не подходит — это не сбой.
  EXPERT_CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

// Сознательно БЕЗ FK на users/experts (как в E3): связь строкой, join —
// вручную в сервисах. FK оставлены только на Topic и на внутренние
// ChatMessage/ExpertNote/Review → Consultation.
model Consultation {
  id                 String                    @id @default(uuid())
  requestId          String                    @unique @map("request_id")
  clientUserId       String                    @map("client_user_id")
  clientCode         Int                       @map("client_code")
  expertId           String                    @map("expert_id")
  topicId            String                    @map("topic_id")
  topic              Topic                     @relation(fields: [topicId], references: [id])
  format             String // 'chat' | 'audio' | 'video' — текущий (эскалация меняет)
  isEmergency        Boolean                   @default(false) @map("is_emergency")
  priceTiyn          Int                       @map("price_tiyn") // снапшот цены эксперта
  plannedDurationMin Int                       @default(50) @map("planned_duration_min")
  status             ConsultationStatus        @default(ACTIVE)
  paymentStatus      ConsultationPaymentStatus @default(UNPAID) @map("payment_status")
  outcome            ConsultationOutcome?
  startedAt          DateTime                  @map("started_at")
  endedAt            DateTime?                 @map("ended_at")
  clientJoinedAt     DateTime?                 @map("client_joined_at") // медиа-вебхук
  expertJoinedAt     DateTime?                 @map("expert_joined_at")
  noShowNotifiedAt   DateTime?                 @map("no_show_notified_at")
  // Напоминание за 15 минут отправлено (Р-15). Без этого поля sweep после
  // рестарта инстанса прислал бы напоминание второй раз.
  remindedAt         DateTime?                 @map("reminded_at")
  messages           ChatMessage[]
  note               ExpertNote?
  review             Review?

  @@index([clientUserId, status])
  @@index([expertId, status])
  // Рабочий запрос sweep'а плановых: status = 'SCHEDULED' AND started_at <= now().
  @@index([status, startedAt])
  // Плюс два частичных уникальных индекса (raw SQL в миграциях, Prisma их
  // не выражает):
  //   consultations_expert_slot_uq — UNIQUE(expert_id, started_at)
  //     WHERE status IN ('SCHEDULED','ACTIVE'): защита от гонки двух
  //     клиентов на один плановый слот (проверка перед вставкой под
  //     нагрузкой даёт двойную запись);
  //   consultations_expert_active_uq — UNIQUE(expert_id)
  //     WHERE status = 'ACTIVE': эксперт ведёт не больше одной
  //     консультации одновременно. BUSY выставляется уже после коммита
  //     первого accept, поэтому до него эксперт успевает принять второй
  //     оффер (найдено нагрузочным прогоном E11).
  @@map("consultations")
}

model ChatMessage {
  id             String       @id @default(uuid())
  consultationId String       @map("consultation_id")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  senderRole     String       @map("sender_role") // 'client' | 'expert'
  ciphertext     Bytes // AES-256-GCM: iv(12) + tag(16) + data
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([consultationId, createdAt])
  @@map("chat_messages")
}

model ExpertNote {
  consultationId String       @id @map("consultation_id")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  expertId       String       @map("expert_id")
  ciphertext     Bytes
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("expert_notes")
}

model Review {
  id             String       @id @default(uuid())
  consultationId String       @unique @map("consultation_id")
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  clientUserId   String       @map("client_user_id")
  expertId       String       @map("expert_id")
  rating         Int // 1..5
  publicText     String?      @map("public_text")
  tags           String[]     @default([]) // коды из REVIEW_TAGS, не подписи
  privateText    String?      @map("private_text") // видит только команда качества
  expertReply    String?      @map("expert_reply")
  status         ReviewStatus @default(PUBLISHED)
  complaint      String? // текст жалобы эксперта
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([expertId, status])
  @@map("reviews")
}

// Как в E3/E4: без FK на users/experts/consultations — связь строкой.
model PaymentMethod {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  providerToken String    @map("provider_token") // токен карты у провайдера, PAN не храним
  maskedPan     String    @map("masked_pan") // "**** 4521"
  brand         String // 'visa' | 'mastercard' | ...
  holderName    String    @map("holder_name")
  deletedAt     DateTime? @map("deleted_at") // soft-delete: история платежей ссылается
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("payment_methods")
}

model Payment {
  id                  String        @id @default(uuid())
  consultationId      String        @unique @map("consultation_id")
  clientUserId        String        @map("client_user_id")
  expertId            String        @map("expert_id")
  paymentMethodId     String        @map("payment_method_id")
  amountTiyn          Int           @map("amount_tiyn") // полная цена (снапшот priceTiyn)
  discountTiyn        Int           @default(0) @map("discount_tiyn") // Premium Р-03 — E12, пока 0
  commissionTiyn      Int           @map("commission_tiyn") // Math.round(amount*rate), фиксируется при capture
  // Снимок ставки комиссии в базисных пунктах: 1500 = 15 % (обычная),
  // 500 = 5 % (Premium, Р-03 — скидку клиенту платит платформа). Без
  // снимка через год не восстановить, почему на строке именно эта сумма.
  commissionRateBp    Int           @default(1500) @map("commission_rate_bp")
  status              PaymentStatus @default(PENDING)
  providerHoldId      String?       @map("provider_hold_id") // id операции у провайдера
  holdCreatedAt       DateTime?     @map("hold_created_at") // для перехолда >5 дней
  holdAttempts        Int           @default(0) @map("hold_attempts") // № попытки pay -> ключ идемпотентности hold
  reholdCount         Int           @default(0) @map("rehold_count")
  settleAttempts      Int           @default(0) @map("settle_attempts") // ретраи capture/void
  lastSettleAttemptAt DateTime?     @map("last_settle_attempt_at") // интервал между ретраями settle
  failReason          String?       @map("fail_reason")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([status, holdCreatedAt])
  @@index([providerHoldId]) // поиск по вебхуку hold.voided_by_bank
  @@index([expertId, status, updatedAt]) // earnings эксперта
  @@map("payments")
}

model LedgerTransaction {
  id        String        @id @default(uuid())
  kind      String // 'capture' | 'payout_reserve' | 'payout_sent' | 'payout_reject' | 'adjustment'
  refId     String        @map("ref_id") // paymentId | payoutId
  createdAt DateTime      @default(now()) @map("created_at")
  entries   LedgerEntry[]

  @@unique([kind, refId]) // идемпотентность проводок
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String            @map("transaction_id")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       String // 'expert:{id}' | 'platform:commission' | 'acquirer:settlement' | 'payout:pending' | 'payout:sent'
  debitTiyn     Int               @default(0) @map("debit_tiyn") // ровно одно из debit/credit > 0
  creditTiyn    Int               @default(0) @map("credit_tiyn")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([account, createdAt])
  @@map("ledger_entries")
}

model Payout {
  id            String       @id @default(uuid())
  expertId      String       @map("expert_id")
  amountTiyn    Int          @map("amount_tiyn")
  maskedPan     String       @map("masked_pan") // карта вывода (снапшот)
  holderName    String       @map("holder_name")
  cardToken     String       @map("card_token") // токен карты вывода у payout-провайдера
  status        PayoutStatus
  rejectReason  String?      @map("reject_reason")
  providerRefId String?      @map("provider_ref_id")
  reviewedBy    String?      @map("reviewed_by") // 'auto' | админ
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([expertId, createdAt])
  @@index([status])
  @@index([providerRefId]) // поиск по вебхуку payout.paid
  @@map("payouts")
}

model ProviderEvent {
  id              String   @id @default(uuid())
  providerEventId String   @map("provider_event_id")
  kind            String // 'payment' | 'payout'
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  // Дедуп повторных доставок В ПРЕДЕЛАХ провайдера: eventId разных
  // провайдеров могут совпадать, глобальный unique терял бы второе событие.
  @@unique([kind, providerEventId])
  @@map("provider_events")
}

enum DevicePlatform {
  ios
  android
}

// Push-токен устройства (E9). Токен уникален ГЛОБАЛЬНО: повторная
// регистрация тем же токеном другим пользователем — перепривязка (телефон
// сменил аккаунт), делается upsert'ом в DevicesService, не вторым create.
// Без FK на users (конвенция E3+): связь строкой, join вручную.
model Device {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  platform  DevicePlatform
  token     String         @unique
  locale    String         @default("ru") // локаль устройства на момент регистрации
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("devices")
}

enum AdminRole {
  VERIFICATION_OPERATOR
  SUPPORT_OPERATOR
  QUALITY_TEAM
  FINANCE_CONTROL
  SUPERADMIN
}

// Сотрудник админки (E8a). Роли — плоский список без гранулярных
// permissions: набор разрешённых действий для каждой роли задаётся кодом
// (guards), не данными. Один сотрудник может иметь несколько ролей.
// Refresh-токен сотрудника админки (E11a, задача 4). Отдельная таблица, а
// не общая с пользовательской: у сотрудников свой жизненный цикл (отзыв при
// деактивации) и другой владелец, а смешивать субъектов в одной таблице
// значит рано или поздно отозвать не тот токен.
model AdminRefreshToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Каскад: токены принадлежат сотруднику и без него не имеют смысла.
  // Без каскада любое удаление сотрудника (в том числе уборка тестов)
  // упиралось бы в FK.
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt])
  @@map("admin_refresh_tokens")
}

// Одноразовый код восстановления доступа сотрудника (E11a, задача 5).
// Хранится хешем: утечка таблицы не должна давать вход в обход 2FA.
model AdminRecoveryCode {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  codeHash    String    @unique @map("code_hash")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, usedAt])
  @@map("admin_recovery_codes")
}

model AdminUser {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String      @map("password_hash")
  roles         AdminRole[]
  isActive      Boolean     @default(true) @map("is_active")
  lastLoginAt   DateTime?   @map("last_login_at")
  // Секрет TOTP (E11a, задача 5) лежит ЗАШИФРОВАННЫМ тем же приёмом, что
  // содержимое чата (AES-256-GCM, MessageCipher): база с открытыми
  // секретами второго фактора — это второй фактор, который знает любой,
  // у кого есть дамп.
  totpSecret    String?     @map("totp_secret")
  totpEnabledAt DateTime?   @map("totp_enabled_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  refreshTokens AdminRefreshToken[]
  recoveryCodes AdminRecoveryCode[]

  @@map("admin_users")
}

// In-app уведомление (E9, §5.8). title/body — снапшот шаблона по локали
// получателя на момент dispatch. Поля доставки — данные метрики §11.6:
// pushSentAt (шина отправила провайдеру), pushDeliveredAt (ack устройства),
// smsFallbackAt (SMS-добивка критичного пуша), readAt (прочитано в центре).
model Notification {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String
  title           String
  body            String
  data            Json
  pushSentAt      DateTime? @map("push_sent_at")
  pushDeliveredAt DateTime? @map("push_delivered_at")
  smsFallbackAt   DateTime? @map("sms_fallback_at")
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type, pushDeliveredAt, smsFallbackAt]) // выборка sweep-fallback
  // Частичный индекс под тот же sweep (E11a, задача 10): рабочее множество
  // — единицы строк, а таблица растёт монотонно, и трёхколоночный btree
  // выше сканирует лишнее. Создаётся вручную в миграции: частичные индексы
  // Prisma в schema не выражает.
  @@map("notifications")
}

// Очередь отправки пушей (E11a, задача 3). Веер сетевых вызовов по всем
// устройствам получателя снят с пути запроса: `POST /v1/requests` пишет
// одну строку сюда, а рассылкой занимается sweep. Путь создания заявки —
// самый латентно-критичный в продукте (ТЗ §6: p95 подбора ≤ 5 с), и
// добавлять к нему N сетевых вызовов нельзя.
model NotificationOutbox {
  id             String    @id @default(uuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  type           String
  payload        Json
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @map("next_attempt_at")
  sentAt         DateTime? @map("sent_at")
  deadAt         DateTime? @map("dead_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([sentAt, deadAt, nextAttemptAt])
  @@map("notification_outbox")
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum TicketAuthorType {
  CLIENT
  EXPERT
  GUEST
}

enum TicketCategory {
  CONSULTATIONS
  PAYMENT
  PAYOUTS
  TECHNICAL
  VERIFICATION
  SECURITY
  CLIENT_QUESTION
  ACCOUNT_DATA
  OTHER
}

// Команда-исполнитель тикета (Р-23). Совпадает по значениям с
// профильными ролями AdminRole (кроме SUPERADMIN) — очередь задачи 8
// фильтрует тикеты по роли вошедшего сотрудника напрямую этим полем.
enum TicketTeam {
  SUPPORT_OPERATOR
  VERIFICATION_OPERATOR
  FINANCE_CONTROL
  QUALITY_TEAM
}

// Обращение в поддержку (E8a, Р-23/БП-09). Автор — клиент/эксперт (по
// User.expert) или гость (без токена, тогда обязателен contactEmail/Phone).
// Категории раздельны по типу автора (см. ticket-routing.ts), маршрутизация
// в team — тоже там, чистой функцией. body — текст исходного обращения;
// дальнейшая переписка — TicketMessage. Без FK на users/consultations/payouts
// (конвенция E3+): связь строкой, join вручную при необходимости.
model Ticket {
  id                    String           @id @default(uuid())
  authorType            TicketAuthorType @map("author_type")
  authorUserId          String?          @map("author_user_id")
  contactEmail          String?          @map("contact_email")
  contactPhone          String?          @map("contact_phone")
  category              TicketCategory
  subject               String
  body                  String
  status                TicketStatus     @default(NEW)
  team                  TicketTeam
  firstReplyAt          DateTime?        @map("first_reply_at")
  resolvedAt            DateTime?        @map("resolved_at")
  relatedConsultationId String?          @map("related_consultation_id")
  relatedPayoutId       String?          @map("related_payout_id")
  // Назначение обращения сотруднику (E11a, задача 8). Без него очередь
  // общая, и двое операторов отвечают в один тикет, не зная друг о друге.
  assignedToId          String?          @map("assigned_to_id")
  // @default(now()) — страховка на случай записи мимо TicketsService;
  // само значение TicketsService.create() ВСЕГДА проставляет явно через
  // ClockService.now(), иначе виртуальное время в e2e не подчиняет момент
  // создания тикета (урок E9).
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  messages              TicketMessage[]

  // (team, status, createdAt), а не (status, team, createdAt): дефолтный
  // запрос очереди GET /v1/admin/tickets (без фильтра status) —
  // WHERE team IN (...) ORDER BY created_at DESC, id DESC — не содержит
  // status в предикате вообще, поэтому status как ведущая колонка индекс не
  // обслуживает (финальное ревью E8a, п.6). team ведущей колонкой обслуживает
  // и «вся своя очередь», и «своя очередь + фильтр status».
  @@index([team, status, createdAt])
  @@index([authorUserId, createdAt])
  @@map("tickets")
}

// Сообщение переписки по тикету (ответ сотрудника/автора). authorKind:
// 'user' | 'staff'; authorId — id User либо AdminUser в зависимости от
// authorKind (без FK — разные таблицы). Пишет задача 8 (ответ сотрудника),
// в задаче 7 таблица только создаётся и читается (пустая при создании тикета).
model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  authorKind String   @map("author_kind")
  authorId   String?  @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

enum SubscriptionPlan {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE // оплачен текущий период
  GRACE // оплата не прошла, идут ретраи — доступ сохраняется (Р-09)
  CANCELLED // отменена клиентом, доступ до currentPeriodEnd
  EXPIRED // период кончился, доступа нет
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  user             User               @relation(fields: [userId], references: [id])
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)
  // Конец оплаченного периода. Доступ есть, пока now() < currentPeriodEnd,
  // независимо от того, отменена подписка или нет (Р-09).
  currentPeriodEnd DateTime           @map("current_period_end")
  paymentMethodId  String             @map("payment_method_id")
  // Ретраи автопродления: 3 попытки за 72 часа от firstFailedAt (Р-09).
  renewAttempts    Int                @default(0) @map("renew_attempts")
  firstFailedAt    DateTime?          @map("first_failed_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  // Рабочий запрос sweep'а: кому пора продлевать.
  @@index([status, currentPeriodEnd])
  // Плюс частичный уникальный индекс subscriptions_active_uq (raw SQL в
  // миграции 20260826170000_premium):
  //   UNIQUE(user_id) WHERE status IN ('ACTIVE','GRACE','CANCELLED').
  // Prisma частичные индексы не выражает — не удалять при prisma migrate dev.
  @@map("subscriptions")
}
