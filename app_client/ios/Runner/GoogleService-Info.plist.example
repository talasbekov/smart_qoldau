<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ПРИМЕР. Реальный GoogleService-Info.plist в git не кладётся (см. .gitignore):
     его выдаёт консоль Firebase для конкретного проекта, а APNs-ключ загружается
     туда же. Положите файл рядом под именем GoogleService-Info.plist. -->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>EXAMPLE-REPLACE-WITH-REAL-KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>BUNDLE_ID</key>
	<string>kz.smartqoldau.appClient</string>
	<key>PROJECT_ID</key>
	<string>smartqoldau-example</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>IS_GCM_ENABLED</key>
	<true/>
</dict>
</plist>
